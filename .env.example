# ─────────────────────────────────────────────
# TradeForge B2B Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────

# ── General ──────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL Database ───────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=tradeforge
DB_PASSWORD=changeme
DB_NAME=tradeforge_dev

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JSON Web Tokens ───────────────────────────
# Generate strong secrets: `openssl rand -hex 64`
JWT_SECRET=replace_with_strong_secret_min_64_chars
JWT_REFRESH_SECRET=replace_with_different_strong_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Apache Kafka ──────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Elasticsearch ─────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Service Ports ─────────────────────────────
IDENTITY_SERVICE_PORT=3001
COMPANY_SERVICE_PORT=3002
TRADE_CORE_SERVICE_PORT=3003

# ── AWS ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── AWS S3 ────────────────────────────────────
S3_BUCKET=tradeforge-assets-dev

# ── SMTP / Email ──────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@tradeforge.io
SMTP_PASSWORD=changeme

# ── Multi-Factor Authentication ───────────────
MFA_ISSUER=TradeForge

# ── Error Tracking (Sentry) ───────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Distributed Tracing (OpenTelemetry / Jaeger) ─
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
